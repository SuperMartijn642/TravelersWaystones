{
  "required": true,
  "minVersion": "${mixin_minimum_version}",
  "package": "${mod_package}.${mixin_package}",
  "compatibilityLevel": "${mixin_compatibility_level}",
  "mixins": [
    "MinecraftServerMixin",
    "PlayerListMixin",
    "PlayerMixin",
    "ServerPlayerMixin"
  ],
  "client": [
    "ClientLevelMixin",
    "ClientPacketListenerMixin",
    "GuiMixin",
    "KeyboardHandlerMixin",
    "LevelRendererMixin",
    "MinecraftMixin",
    "RenderTypeMixin",
    "ClientModLoaderMixin"
  ],
  "server": [
    "ServerMainMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  }
}
